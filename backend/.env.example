PORT=5000
NODE_ENV=development
JWT_SECRET=change_this_super_secret_key
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=support_ticketing
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Signups allowed per IP per window (default 10 per hour)
SIGNUP_RATE_LIMIT_WINDOW_MS=3600000
SIGNUP_RATE_LIMIT_MAX=10
# All /api requests per IP per window (default 1000 per 15 minutes)
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=1000
CORS_ORIGIN=http://localhost:5173
# Days after closing during which a client may reopen their ticket
REOPEN_WINDOW_DAYS=7

# Email Configuration
# Email Configuration
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-app-password